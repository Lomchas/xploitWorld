{
  "name": "@null-protocol/backend",
  "private": true,
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "resolve:dispute": "node --import tsx prisma/resolve-dispute.ts",
    "demo:pvp": "node --import tsx prisma/demo-pvp.ts",
    "test": "vitest run",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration.ts test/pvp.integration.ts test/exchange.integration.ts test/campaign.integration.ts test/worlds.integration.ts",
    "migrate:split": "node --import tsx prisma/split-worlds.ts"
  },
  "dependencies": {
    "@null-protocol/shared": "workspace:*",
    "@prisma/client": "6",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "prisma": "6",
    "ws": "^8.22.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.16.0",
    "typescript": "~5.5.4",
    "@types/cors": "^2.8.17",
    "vitest": "^3.2.7"
  }
}
